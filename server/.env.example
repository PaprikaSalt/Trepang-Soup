APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:1420","http://localhost:1420","tauri://localhost","http://tauri.localhost"]
DATABASE_URL=sqlite+aiosqlite:///./data/trepang.db

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_CONCURRENCY=8
DEEPSEEK_RETRY_BASE_SECONDS=0.5
DEEPSEEK_GENERATION_ATTEMPTS=3
DEEPSEEK_TRUST_ENV=false

ADMIN_PASSWORD_HASH=
ADMIN_CHALLENGE_TTL_SECONDS=60
ADMIN_TOKEN_TTL_SECONDS=900
ADMIN_MAX_FAILURES=5
ADMIN_LOCKOUT_SECONDS=60
SESSION_SIGNING_KEY=
ROOM_IDLE_SECONDS=86400
ROOM_CLEANUP_INTERVAL_SECONDS=30
ROOM_SETTLEMENT_GRACE_SECONDS=5
HOST_TRANSFER_SECONDS=90
MAX_ROOM_PLAYERS=20
RECENT_PUZZLE_WINDOW=10
